<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/et_nombre_taller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/hint_nombre_taller"
            android:inputType="textCapWords"
            android:maxLength="50"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#12122A"
            android:textColorHint="#AAAACC" />

        <EditText
            android:id="@+id/et_direccion_taller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/hint_direccion_taller"
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#12122A"
            android:textColorHint="#AAAACC" />

        <EditText
            android:id="@+id/et_telefono_taller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/hint_telefono_taller"
            android:inputType="phone"
            android:maxLength="9"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#12122A"
            android:textColorHint="#AAAACC" />

        <TextView
            android:id="@+id/tv_autorizado_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_autorizado_pregunta"
            android:textColor="#12122A"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cb_autorizado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_autorizado"
            android:textColor="#12122A"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:buttonTint="#12122A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancelar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_cancelar"
                android:textColor="#12122A"
                app:strokeColor="#12122A"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btn_guardar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_guardar"
                android:backgroundTint="#12122A"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>