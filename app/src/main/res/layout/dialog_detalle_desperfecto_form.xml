<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background_white">

    <TextView
        android:id="@+id/tv_form_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_nuevo_desperfecto"
        android:textColor="@color/primary_blue"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- SELECCIÓN DE VEHÍCULO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_seleccione_vehiculo"
        android:textColor="@color/primary_blue"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/sp_form_vehiculo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_spinner"
        android:popupBackground="#1E1E3F"
        android:layout_marginBottom="12dp" />

    <!-- SELECCIÓN DE TIPO DE DAÑO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_tipo_desperfecto"
        android:textColor="@color/primary_blue"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/sp_form_tipo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_spinner"
        android:popupBackground="#1E1E3F"
        android:layout_marginBottom="12dp" />

    <!-- TÍTULO DE DESCRIPCIÓN -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_descripcion_desperfecto"
        android:textColor="@color/primary_blue"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_form_descripcion"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="@string/hint_descripcion_desperfecto"
        android:gravity="top"
        android:padding="12dp"
        android:background="@drawable/bg_search"
        android:textColor="@color/text_light"
        android:textColorHint="@color/primary_blue_light"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"
        android:inputType="textMultiLine"
        android:importantForAutofill="no" />

    <!-- SECCIÓN DE FOTOS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_fotos_evidencia"
            android:textColor="@color/primary_blue"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_form_agregar_foto"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_agregar_foto"
            android:textColor="@color/accent_orange" />
    </LinearLayout>

    <!-- LISTA DE FOTOS -->
    <ScrollView
        android:id="@+id/scroll_fotos"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/secondary_gray"
        android:contentDescription="@string/desc_lista_fotos"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/ll_form_fotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- BOTONES DE ACCIÓN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_form_cancelar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_cancelar"
            android:textColor="@color/primary_blue"
            app:strokeColor="@color/primary_blue"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btn_form_guardar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/btn_guardar"
            android:backgroundTint="@color/primary_blue"
            android:textColor="@color/background_white"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>