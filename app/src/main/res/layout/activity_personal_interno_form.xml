<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- CABECERA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_blue_dark"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/form_personal_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo Personal"
            android:textColor="@color/text_light"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complete los datos del personal"
            android:textColor="@color/primary_blue_light"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- FORMULARIO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre *"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_nombre_personal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Nombre del personal"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPersonName"
                android:layout_marginBottom="20dp" />

            <!-- Apellido -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apellido *"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_apellido_personal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Apellido del personal"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPersonName"
                android:layout_marginBottom="20dp" />

            <!-- Cargo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargo *"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_cargo_personal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Cargo o puesto"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textCapWords"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/background_white">

        <Button
            android:id="@+id/btn_cancelar_personal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:backgroundTint="@color/primary_blue_light"
            android:textColor="@color/primary_blue_dark"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_guardar_personal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Guardar"
            android:backgroundTint="@color/primary_blue_dark"
            android:textColor="@color/text_light" />

    </LinearLayout>

</LinearLayout>
