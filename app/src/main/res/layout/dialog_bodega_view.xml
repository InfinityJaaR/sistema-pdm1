<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- ID de la Bodega -->
    <TextView
        android:id="@+id/tv_id_bodega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textSize="13sp"
        android:textColor="#888888" />

    <!-- Label: Distrito -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_distrito"
        android:textColor="#555555"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Valor: Distrito -->
    <TextView
        android:id="@+id/tv_distrito_bodega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textSize="16sp"
        android:textColor="#12122A" />

    <!-- Label: Nombre -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_nombre_bodega"
        android:textColor="#555555"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Valor: Nombre -->
    <TextView
        android:id="@+id/tv_nombre_bodega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#12122A" />

    <!-- Label: Dirección -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_direccion_bodega"
        android:textColor="#555555"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Valor: Dirección -->
    <TextView
        android:id="@+id/tv_direccion_bodega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:textSize="16sp"
        android:textColor="#12122A" />

    <!-- Botón Cerrar -->
    <Button
        android:id="@+id/btn_cerrar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_cerrar"
        android:backgroundTint="#12122A"
        android:textColor="#FFFFFF"
        app:cornerRadius="8dp" />

</LinearLayout>
