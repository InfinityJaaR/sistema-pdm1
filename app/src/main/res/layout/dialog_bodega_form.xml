<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distrito"
            android:textColor="#555555"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/sp_id_distrito"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/et_nombre_bodega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Nombre de la bodega"
            android:inputType="textCapWords"
            android:maxLength="50"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#12122A"
            android:textColorHint="#AAAACC" />

        <EditText
            android:id="@+id/et_direccion_bodega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Dirección de la bodega"
            android:inputType="textCapSentences"
            android:maxLength="200"
            android:padding="12dp"
            android:textSize="16sp"
            android:textColor="#12122A"
            android:textColorHint="#AAAACC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancelar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_cancelar"
                android:textColor="#12122A"
                app:strokeColor="#12122A"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btn_guardar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_guardar"
                android:backgroundTint="#12122A"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
