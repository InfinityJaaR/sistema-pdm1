<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- CABECERA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_blue_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/primary_blue"
            android:gravity="center"
            android:layout_marginEnd="14dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_truck"
                app:tint="@color/text_light" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/detail_tipo_movimiento_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_light"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/detail_fecha_movimiento_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_blue_light"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_editar_movimiento"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/text_light"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- DETALLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Tipo -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_tipo_movimiento" android:textSize="11sp"
                    android:textColor="@color/text_secondary" android:letterSpacing="0.1" />
                <TextView android:id="@+id/detail_tipo_movimiento"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider_gray" android:layout_marginBottom="16dp" />

                <!-- Fecha -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_fecha" android:textSize="11sp"
                    android:textColor="@color/text_secondary" android:letterSpacing="0.1" />
                <TextView android:id="@+id/detail_fecha_movimiento"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider_gray" android:layout_marginBottom="16dp" />

                <!-- Motivo -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_motivo" android:textSize="11sp"
                    android:textColor="@color/text_secondary" android:letterSpacing="0.1" />
                <TextView android:id="@+id/detail_motivo_movimiento"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider_gray" android:layout_marginBottom="16dp" />

                <!-- Vehículo -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_vehiculo_vin" android:textSize="11sp"
                    android:textColor="@color/text_secondary" android:letterSpacing="0.1" />
                <TextView android:id="@+id/detail_vehiculo_movimiento"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider_gray" android:layout_marginBottom="16dp" />

                <!-- Transporte -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_transporte_detalle" android:textSize="11sp"
                    android:textColor="@color/text_secondary" android:letterSpacing="0.1" />
                <TextView android:id="@+id/detail_transporte_movimiento"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider_gray" android:layout_marginBottom="16dp" />

                <!-- Personal -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_personal_detalle" android:textSize="11sp"
                    android:textColor="@color/text_secondary" android:letterSpacing="0.1" />
                <TextView android:id="@+id/detail_personal_movimiento"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider_gray" android:layout_marginBottom="16dp" />

                <!-- Bodega -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/label_bodega_detalle" android:textSize="11sp"
                    android:textColor="@color/text_secondary" android:letterSpacing="0.1" />
                <TextView android:id="@+id/detail_bodega_movimiento"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
