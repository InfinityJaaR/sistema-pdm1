<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F7">

    <!-- 1. CABECERA (Header) -->
    <LinearLayout
        android:id="@+id/layout_vehiculo_cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#12122A"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_vehiculo_titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_vehiculos"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_vehiculo_subtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle_inventario"
                    android:textColor="#AAAACC"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Botón Agregar (+) -->
            <ImageButton
                android:id="@+id/btn_vehiculo_agregar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="@string/desc_agregar_nuevo"
                app:tint="#FFFFFF"
                android:padding="11dp"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- 2. BARRA DE BÚSQUEDA -->
        <LinearLayout
            android:id="@+id/layout_vehiculo_busqueda"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_search"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            tools:ignore="RtlPadding">

            <!-- Entrada de texto -->
            <EditText
                android:id="@+id/et_vehiculo_buscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:background="@null"
                android:hint="@string/hint_buscar"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAACC"
                android:textSize="14sp"
                android:inputType="text"
                android:autofillHints="none"
                android:importantForAccessibility="yes" />

            <!-- Lupa de búsqueda -->
            <ImageButton
                android:id="@+id/btn_vehiculo_lupa"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_search"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/desc_boton_buscar" />

        </LinearLayout>
    </LinearLayout>

    <!-- 3. CUERPO (Listado) -->
    <LinearLayout
        android:id="@+id/layout_vehiculo_cuerpo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <ListView
            android:id="@+id/lv_vehiculo_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_vehiculo" />

    </LinearLayout>
</LinearLayout>