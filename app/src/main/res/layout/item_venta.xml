<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_item_selector"
    android:layout_marginBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_venta_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Venta #000"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#12122A" />

        <TextView
            android:id="@+id/item_venta_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024-05-20"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_venta_precio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginEnd="12dp"/>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_arrow_right"
        app:tint="#AAAACC" />

</LinearLayout>