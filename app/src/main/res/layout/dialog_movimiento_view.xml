<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_movimiento_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textSize="13sp"
        android:textColor="#888888" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tipo de movimiento"
        android:textSize="11sp"
        android:textColor="#AAAACC"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tv_movimiento_tipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#12122A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fecha"
        android:textSize="11sp"
        android:textColor="#AAAACC"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tv_movimiento_fecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textSize="16sp"
        android:textColor="#12122A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Transporte"
        android:textSize="11sp"
        android:textColor="#AAAACC"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tv_movimiento_transporte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textSize="16sp"
        android:textColor="#12122A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Personal"
        android:textSize="11sp"
        android:textColor="#AAAACC"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tv_movimiento_personal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textSize="16sp"
        android:textColor="#12122A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vehículo"
        android:textSize="11sp"
        android:textColor="#AAAACC"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tv_movimiento_vehiculo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textSize="16sp"
        android:textColor="#12122A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bodega"
        android:textSize="11sp"
        android:textColor="#AAAACC"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tv_movimiento_bodega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textSize="16sp"
        android:textColor="#12122A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Motivo"
        android:textSize="11sp"
        android:textColor="#AAAACC"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tv_movimiento_motivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:textSize="16sp"
        android:textColor="#12122A" />

    <Button
        android:id="@+id/btn_cerrar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Cerrar"
        android:backgroundTint="#12122A"
        android:textColor="#FFFFFF"
        app:cornerRadius="8dp" />

</LinearLayout>
