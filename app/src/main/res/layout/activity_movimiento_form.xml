<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- CABECERA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_blue_dark"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/form_movimiento_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_nuevo_movimiento"
            android:textColor="@color/text_light"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_form_movimiento"
            android:textColor="@color/primary_blue_light"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- FORMULARIO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/form_horizontal_padding"
            android:paddingEnd="@dimen/form_horizontal_padding"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Tipo de Movimiento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_tipo_movimiento"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/actv_tipo_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="@string/hint_tipo_movimiento"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="none"
                android:focusable="false"
                android:layout_marginBottom="20dp" />

            <!-- Fecha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_fecha"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_fecha_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="@string/hint_fecha_formato"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginBottom="20dp" />

            <!-- Vehículo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_vehiculo"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/actv_vehiculo_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="@string/hint_seleccione_vehiculo"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:layout_marginBottom="20dp" />

            <!-- Transporte -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_transporte"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/actv_transporte_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="@string/hint_seleccione_transporte"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:layout_marginBottom="20dp" />

            <!-- Personal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_personal_interno"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/actv_personal_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="@string/hint_seleccione_personal"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:layout_marginBottom="20dp" />

            <!-- Bodega -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_bodega"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/actv_bodega_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="@string/hint_seleccione_bodega"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="text"
                android:layout_marginBottom="20dp" />

            <!-- Motivo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_motivo"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_motivo_movimiento"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_search_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:hint="@string/hint_motivo"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/background_white">

        <Button
            android:id="@+id/btn_cancelar_movimiento"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_cancelar"
            android:backgroundTint="@color/primary_blue_light"
            android:textColor="@color/primary_blue_dark"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_guardar_movimiento"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_guardar"
            android:backgroundTint="@color/primary_blue_dark"
            android:textColor="@color/text_light" />

    </LinearLayout>

</LinearLayout>
