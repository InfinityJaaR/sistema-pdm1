<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- CABECERA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_blue_dark"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/form_movimiento_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo Movimiento"
            android:textColor="@color/text_light"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complete los datos del movimiento"
            android:textColor="@color/primary_blue_light"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- FORMULARIO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tipo de Movimiento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de Movimiento *"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/actv_tipo_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Entrada / Salida"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="none"
                android:focusable="false"
                android:layout_marginBottom="20dp" />

            <!-- Fecha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha *"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_fecha_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="yyyy-MM-dd"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginBottom="20dp" />

            <!-- Vehículo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehículo *"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/actv_vehiculo_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Seleccione el vehículo"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="none"
                android:focusable="false"
                android:layout_marginBottom="20dp" />

            <!-- Transporte -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transporte *"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/actv_transporte_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Seleccione el transporte"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="none"
                android:focusable="false"
                android:layout_marginBottom="20dp" />

            <!-- Personal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Interno *"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/actv_personal_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Seleccione el personal"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="none"
                android:focusable="false"
                android:layout_marginBottom="20dp" />

            <!-- Bodega -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bodega *"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/actv_bodega_movimiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Seleccione la bodega"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="none"
                android:focusable="false"
                android:layout_marginBottom="20dp" />

            <!-- Motivo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motivo *"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_motivo_movimiento"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_search_white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:hint="Motivo del movimiento"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/background_white">

        <Button
            android:id="@+id/btn_cancelar_movimiento"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:backgroundTint="@color/primary_blue_light"
            android:textColor="@color/primary_blue_dark"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_guardar_movimiento"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Guardar"
            android:backgroundTint="@color/primary_blue_dark"
            android:textColor="@color/text_light" />

    </LinearLayout>

</LinearLayout>
